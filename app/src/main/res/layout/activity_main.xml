<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:textSize="48sp"
        android:gravity="end|center_vertical"
        android:text="0"
        android:textColor="#FFFFFF"
        android:background="#1E1E1E"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="4">

        <Button android:id="@+id/btn7" android:text="7" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btn8" android:text="8" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btn9" android:text="9" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btnDiv" android:text="/" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>

        <Button android:id="@+id/btn4" android:text="4" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btn5" android:text="5" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btn6" android:text="6" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btnMul" android:text="*" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>

        <Button android:id="@+id/btn1" android:text="1" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btn2" android:text="2" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btn3" android:text="3" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btnSub" android:text="-" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>

        <Button android:id="@+id/btn0" android:text="0" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btnClear" android:text="C" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btnEquals" android:text="=" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/btnAdd" android:text="+" android:textSize="24sp" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1"/>

    </GridLayout>

</LinearLayout>
          
